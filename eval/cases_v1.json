{
  "corpus": "cat.txt",
  "chunking": "one fact per line, stable ids c001..c150",
  "notes": [
    "expected_chunk_ids: every chunk that is a correct source for the question. recall@k needs all of them, hit@k needs any.",
    "acceptable_chunk_ids: alternative chunks that are also a correct source (used for hit@k / MRR only, not recall).",
    "must_include: lowercase substrings that must appear in the generated answer. Measures the end-to-end pipeline, not just retrieval.",
    "forbidden: substrings that indicate a fabricated detail (trap values that look plausible).",
    "answerable: false means the corpus deliberately does not contain the answer and the system should abstain."
  ],
